{
    "name": "rocket-launcher-extension",
    "version": "1.2.0",
    "description": "Rocket Launcher - Adobe Illustrator Extension",
    "main": "index.html",
    "scripts": {
        "test": "jest",
        "test:watch": "jest --watch",
        "e2e": "playwright test"
    },
    "devDependencies": {
        "jest": "^29.7.0",
        "@playwright/test": "^1.40.0"
    },
    "jest": {
        "testEnvironment": "jsdom",
        "testMatch": [
            "**/tests/**/*.test.js"
        ],
        "setupFilesAfterEnv": [
            "<rootDir>/tests/setup.js"
        ]
    },
    "keywords": [
        "adobe",
        "illustrator",
        "cep",
        "extension"
    ],
    "author": "Rocket Launcher Team",
    "license": "MIT"
}