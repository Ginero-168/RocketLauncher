{
    "name": "rocket-launcher-extension",
    "version": "3.1.1",
    "description": "Rocket Launcher - Adobe Illustrator Extension",
    "main": "index.html",
    "scripts": {
        "test": "jest",
        "test:watch": "jest --watch"
    },
    "devDependencies": {
        "jest": "^29.7.0",
        "jest-environment-jsdom": "^29.7.0"
    },
    "jest": {
        "testEnvironment": "jsdom",
        "testMatch": [
            "**/tests/**/*.test.js"
        ],
        "setupFilesAfterEnv": [
            "<rootDir>/tests/setup.js"
        ],
        "testPathIgnorePatterns": [
            "/node_modules/",
            "/\\.claude/"
        ]
    },
    "keywords": [
        "adobe",
        "illustrator",
        "cep",
        "extension"
    ],
    "author": "Rocket Launcher Team",
    "license": "SEE LICENSE IN LICENSE",
    "private": true
}
