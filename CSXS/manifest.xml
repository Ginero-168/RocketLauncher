<?xml version="1.0" encoding="UTF-8"?>
<ExtensionManifest
	Version="5.0"
	ExtensionBundleId="com.tata.pro"
	ExtensionBundleVersion="1.2.0"
	ExtensionBundleName="Rocket Launcher"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

	<ExtensionList>
		<Extension Id="com.tata.pro.panel" Version="1.2.0" />
	</ExtensionList>

	<ExecutionEnvironment>
		<HostList>
			<Host Name="ILST" Version="[24.0,99.9]" />
		</HostList>

	<LocaleList>
		<Locale Code="All" />
	</LocaleList>

	<RequiredRuntimeList>
		<RequiredRuntime Name="CSXS" Version="5.0" />
	</RequiredRuntimeList>
</ExecutionEnvironment>

	<DispatchInfoList>
		<Extension Id="com.tata.pro.panel">
			<DispatchInfo>

			<Resources>
				<MainPath>./index.html</MainPath>
				<ScriptPath>./jsx/hostscript.jsx</ScriptPath>
				<CEFCommandLine>
	   			<Parameter>--enable-nodejs</Parameter>
				<Parameter>--mixed-context</Parameter>
				<Parameter>--allow-file-access</Parameter>
				<Parameter>--allow-file-access-from-files</Parameter>
	 			</CEFCommandLine>
			</Resources>

			<Lifecycle>
				<AutoVisible>true</AutoVisible>
			</Lifecycle>

			<UI>

				<Type>Panel</Type>
				<Menu>Rocket Launcher</Menu>

				<Geometry>
					<Size>
						<Height>300</Height>
						<Width>125</Width>
					</Size>
					<MinSize>
						<Height>20</Height>
						<Width>20</Width>
					</MinSize>
					<MaxSize>
						<Height>1000</Height>
						<Width>1000</Width>
					</MaxSize>
				</Geometry>

			</UI>
		</DispatchInfo>
	</Extension>




</DispatchInfoList>
</ExtensionManifest>
